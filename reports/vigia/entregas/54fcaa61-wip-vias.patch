+++ b/src/render/roads/pieceMesh.ts
@@ -0,0 +1,303 @@
+import earcut from 'earcut';
+
+import { type Chain, type Sampler, chainBetween, ladderTriangles, stationsOf, withStations } from '../mesh/stripShape';
+import { type PieceShape, type SkirtRing, type Tile, type TileMeshOptions, meshShape, surfaceSampler, withoutSection } from '../mesh/tileMesh';
+import { FIXED, type Geom, OWN, type PieceReach, WALL_A, WALL_B, WALL_END, WALL_START } from './pieceGeom';
+import { STATIONS_SLOT, type TileSource, slotOf } from '../roadSurfaceReads';
+
+/**
+ * # A ROAD PIECE MESHED WHOLE (`pieceGeom.ts`)
+ *
+ * A piece's shapes are meshed whole, nothing cut: the piece is drawn in one block, its owner's (`roads/pieceOwner.ts`), which the network's far
+ * level files it under too, so the two levels swap the same pieces. Where two pieces of two blocks meet (a road's end on a junction's mouth) their
+ * vertices are the same numbers, and the blocks' far levels keep them where they are (`seamsOf`, `mesh/roadLodPure.ts` BlockLock).
+ * - The strips of a road share their stations: each asks where its surface leaves its chords (`stripShape.ts` stationsOf, with its own surface's
+ *   tolerances) and every strip of the road takes them all, so two bands meet on their shared edge vertex for vertex.
+ * - A junction's plate is meshed in rings out from its middle: one fan where it is a plane, more rings only where its height leaves the blend of
+ *   the ring inside and the outline (a crowned or a sloping plate). Its outline's points are its own, the mouths the roads' strips end on: no point
+ *   is ever put on an outline edge, so a road's strip and the plate share the mouth line's two ends and nothing else.
+ * - A plate whose outline is not seen whole from its middle is cut by ear clipping (earcut, Mapbox: https://github.com/mapbox/earcut) of its own
+ *   outline alone.
+ */
+
+/** A surface of a pass as a part is meshed of it: what it is made from and what each vertex reads. */
+export interface MeshedSurface {
+  readonly source: TileSource;
+  readonly options: TileMeshOptions & { readonly name: string };
+}
+
+/** Rings at most a plate is cut into out from its middle. */
+const MOST_RINGS = 8;
+
+/** Every surface of a piece (its shapes `reach`), each vertex read here: by surface name, in the order of `specs`; `only`, those named alone, their
+ *  stations still asked of every surface of `specs` (a block refilled a surface at a time is the same as built, `roadSurfaces.ts` surfaceSource). */
+export function pieceBundle(reach: PieceReach, specs: readonly MeshedSurface[], only?: ReadonlySet<string>): Map<string, Tile> {
+  const samplers = specs.map((spec) => surfaceSampler(spec.options));
+  // The stations of each group of strips: every station any of them asks, and those the piece names (a dropped kerb's ends).
+  const groups = new Map<number, Set<number>>();
+  const groupOf = (group: number): Set<number> => { let set = groups.get(group); if (!set) groups.set(group, set = new Set()); return set; };
+  for (const g of reach.get(STATIONS_SLOT) ?? []) if (g.kind === 'stations') for (const s of g.s) groupOf(g.group).add(s);
+  specs.forEach((spec, k) => {
+    for (const g of reach.get(slotOf(spec.source)) ?? []) {
+      if (g.kind !== 'strip' || g.group < 0) continue;
+      const sampler = g.plate && spec.options.plateOffRoad ? surfaceSampler(withoutSection(spec.options)) : samplers[k]!;
+      for (const s of stationsOf(g, sampler)) groupOf(g.group).add(s);
+    }
+  });
+  const stations = new Map<number, number[]>([...groups].map(([group, set]) => [group, [...set].sort((p, q) => p - q)]));
+  const bundle = new Map<string, Tile>();
+  specs.forEach((spec, k) => {
+    if (only && !only.has(spec.options.name)) return;
+    const geoms = reach.get(slotOf(spec.source));
+    if (!geoms?.length) return;
+    const sampler = samplers[k]!;
+    const plateSampler = spec.options.plateOffRoad ? surfaceSampler(withoutSection(spec.options)) : sampler;
+    const pieces: PieceShape[] = [];
+    const skirts: SkirtRing[] = [];
+    for (const g of geoms) shapeOf(g, spec.options, g.kind !== 'stations' && g.kind !== 'walls' && g.kind !== 'edge' && g.plate ? plateSampler : sampler, stations, pieces, skirts);
+    if (pieces.length === 0 && skirts.length === 0) return;
+    bundle.set(spec.options.name, meshShape({ pieces, skirts: spec.options.bottom ? skirts : null }, spec.options));
+  });
+  return bundle;
+}
+
+/**
+ * Where a piece meets the pieces next to it, as segments (x0, y0, x1, y1 each): every strip's two ends (a road's end on a junction's mouth, a corner's
+ * on the same mouth, a mitre, a dropped kerb's ends) and a plate's unwalled edges (its mouths). A block's far level keeps every vertex on them where
+ * it is (`mesh/roadLodPure.ts` BlockLock): two blocks drawing the two sides of a mouth meet on the same vertices at every level.
+ */
+export function seamsOf(reach: PieceReach): Float64Array {
+  const out: number[] = [];
+  const end = (c: Chain, last: boolean): [number, number] => last ? [c.xy[c.xy.length - 2]!, c.xy[c.xy.length - 1]!] : [c.xy[0]!, c.xy[1]!];
+  for (const geoms of reach.values()) {
+    for (const g of geoms) {
+      if (g.kind === 'strip') {
+        for (const last of [false, true]) out.push(...end(g.a, last), ...end(g.b, last));
+      } else if (g.kind === 'fan' || g.kind === 'poly') {
+        const count = g.ring.length / 2;
+        for (let i = 0; i < count; i++) {
+          if (g.walls[i]) continue;
+          const j = (i + 1) % count;
+          out.push(g.ring[i * 2]!, g.ring[i * 2 + 1]!, g.ring[j * 2]!, g.ring[j * 2 + 1]!);
+        }
+      }
+    }
+  }
+  return Float64Array.from(out);
+}
+
+/** One shape's triangles and walls, into `pieces` and `skirts`. */
+function shapeOf(g: Geom, options: TileMeshOptions, sampler: Sampler, stations: ReadonlyMap<number, readonly number[]>,
+  pieces: PieceShape[], skirts: SkirtRing[]): void {
+  switch (g.kind) {
+    case 'strip': {
+      const added = g.group >= 0 ? stations.get(g.group) ?? [] : g.group === OWN ? stationsOf(g, sampler) : [];
+      const a = g.group === FIXED ? g.a : withStations(g.a, added);
+      const b = g.group === FIXED ? g.b : withStations(g.b, added);
+      // Cut across into chains where the surface is not a plane across (`TileMeshOptions.across`): a's and b's own points kept, the chains between
+      // at every station of either.
+      const n = Math.max(1, Math.round(options.across ?? 1));
+      const chains: Chain[] = [a];
+      for (let k = 1; k < n; k++) chains.push(chainBetween(a, b, k / n));
+      chains.push(b);
+      const xy: number[] = [], tris: number[] = [];
+      for (let k = 0; k + 1 < chains.length; k++) {
+        const made = ladderTriangles({ a: chains[k]!, b: chains[k + 1]! });
+        const base = xy.length / 2;
+        for (let i = 0; i < made.xy.length; i++) xy.push(made.xy[i]!);
+        for (let i = 0; i < made.tris.length; i++) tris.push(base + made.tris[i]!);
+      }
+      push(pieces, xy, tris, g.plate === true);
+      if (g.walls) {
+        // Its outline: a along, across its end, b back, across its start.
+        const ring: number[] = [];
+        for (let i = 0; i < a.s.length; i++) ring.push(a.xy[i * 2]!, a.xy[i * 2 + 1]!);
+        for (let i = b.s.length - 1; i >= 0; i--) ring.push(b.xy[i * 2]!, b.xy[i * 2 + 1]!);
+        const na = a.s.length, count = ring.length / 2;
+        const walled = new Uint8Array(count);
+        for (let i = 0; i < count; i++) {
+          // Edge i runs from point i to point i + 1.
+          if (i < na - 1) walled[i] = g.walls & WALL_A ? 1 : 0;
+          else if (i === na - 1) walled[i] = g.walls & WALL_END ? 1 : 0;
+          else if (i < count - 1) walled[i] = g.walls & WALL_B ? 1 : 0;
+          else walled[i] = g.walls & WALL_START ? 1 : 0;
+        }
+        wallsOf(ring, walled, skirts);
+      }
+      return;
+    }
+    case 'fan': {
+      const made = fanTriangles(g.cx, g.cy, g.ring, sampler) ?? earTriangles(g.ring);
+      push(pieces, made.xy, made.tris, g.plate === true);
+      wallsOf(g.ring, g.walls, skirts);
+      return;
+    }
+    case 'poly': {
+      const made = earTriangles(g.ring);
+      push(pieces, made.xy, made.tris, g.plate === true);
+      wallsOf(g.ring, g.walls, skirts);
+      return;
+    }
+    case 'walls':
+      if (g.edges.length >= 4) skirts.push({ flip: false, edges: g.edges });
+      return;
+    case 'stations':
+    case 'edge':
+      return;
+  }
+}
+
+/** Least twice-area of a triangle kept, square metres: one with less has no area to draw (two chains meeting at a point, a station on a corner). */
+const LEAST_AREA = 1e-8;
+
+/** Triangles into `pieces`, their winding measured, a triangle with no area left out. */
+function push(pieces: PieceShape[], xy: ArrayLike<number>, tris: ArrayLike<number>, plate: boolean): void {
+  const own = Float64Array.from(xy), kept: number[] = [];
+  for (let t = 0; t + 2 < tris.length; t += 3) {
+    const a = tris[t]! * 2, b = tris[t + 1]! * 2, c = tris[t + 2]! * 2;
+    const twice = (own[b]! - own[a]!) * (own[c + 1]! - own[a + 1]!) - (own[b + 1]! - own[a + 1]!) * (own[c]! - own[a]!);
+    if (Math.abs(twice) > LEAST_AREA) kept.push(tris[t]!, tris[t + 1]!, tris[t + 2]!);
+  }
+  if (kept.length === 0) return;
+  const list = Uint32Array.from(kept);
+  pieces.push({ xy: own, tris: list, flip: trianglesArea(own, list) < 0, ...(plate ? { plate } : {}) });
+}
+
+/** The walled edges of a closed outline (`walls[i]`: the edge from point i to point i + 1), with the outline's winding. */
+function wallsOf(ring: ArrayLike<number>, walls: ArrayLike<number>, skirts: SkirtRing[]): void {
+  const count = ring.length / 2;
+  const edges: number[] = [];
+  for (let i = 0; i < count; i++) {
+    if (!walls[i]) continue;
+    const j = (i + 1) % count;
+    const ax = ring[i * 2]!, ay = ring[i * 2 + 1]!, bx = ring[j * 2]!, by = ring[j * 2 + 1]!;
+    if (Math.abs(bx - ax) + Math.abs(by - ay) < 1e-6) continue;
+    edges.push(ax, ay, bx, by);
+  }
+  if (edges.length) skirts.push({ flip: ringArea(ring) < 0, edges: Float64Array.from(edges) });
+}
+
+/**
+ * A plate in rings out from its middle (`cx`, `cy`), its outline's points the spokes' ends; null where some point of the outline is not seen from the
+ * middle (the angles round it do not go one way). A ring is put between two where, on some spoke, the surface at the quarters or the middle leaves
+ * the blend of the two by more than its tolerance over a stretch longer than its floor (`Sampler`), as a strip's stations are (`stripShape.ts`).
+ */
+function fanTriangles(cx: number, cy: number, ring: ArrayLike<number>, sampler: Sampler): { xy: Float64Array; tris: Uint32Array } | null {
+  const count = ring.length / 2;
+  if (count < 3) return null;
+  let turned = 0;
+  for (let i = 0; i < count; i++) {
+    const j = (i + 1) % count;
+    const a = Math.atan2(ring[i * 2 + 1]! - cy, ring[i * 2]! - cx), b = Math.atan2(ring[j * 2 + 1]! - cy, ring[j * 2]! - cx);
+    let d = b - a;
+    while (d <= -Math.PI) d += 2 * Math.PI;
+    while (d > Math.PI) d -= 2 * Math.PI;
+    if (d <= 1e-9) return null;
+    turned += d;
+  }
+  if (Math.abs(turned - 2 * Math.PI) > 1e-6) return null;
+  const size = sampler.size;
+  const scratch: number[] = [];
+  const at = (i: number, t: number): [number, number] => [cx + (ring[i * 2]! - cx) * t, cy + (ring[i * 2 + 1]! - cy) * t];
+  const read = (t: number): Float64Array => {
+    const out = new Float64Array(count * size);
+    for (let i = 0; i < count; i++) {
+      const [x, y] = at(i, t);
+      sampler.sample(x, y, scratch);
+      for (let k = 0; k < size; k++) out[i * size + k] = scratch[k]!;
+    }
+    return out;
+  };
+  const reachOf = new Float64Array(count);
+  for (let i = 0; i < count; i++) reachOf[i] = Math.hypot(ring[i * 2]! - cx, ring[i * 2 + 1]! - cy);
+  const leaves = (t0: number, t1: number, r0: Float64Array, r1: Float64Array): boolean => {
+    for (const f of [0.25, 0.5, 0.75]) {
+      const got = read(t0 + (t1 - t0) * f);
+      for (let i = 0; i < count; i++) {
+        const span = (t1 - t0) * reachOf[i]!;
+        for (let k = 0; k < size; k++) {
+          if (span <= sampler.floor[k]! || sampler.outline?.[k]) continue;
+          const v = i * size + k;
+          if (Math.abs(got[v]! - (r0[v]! + (r1[v]! - r0[v]!) * f)) > sampler.tolerance[k]!) return true;
+        }
+      }
+    }
+    return false;
+  };
+  const levels: number[] = [1];
+  const visit = (t0: number, t1: number, r0: Float64Array, r1: Float64Array, depth: number): void => {
+    if (levels.length >= MOST_RINGS || depth > 6 || !leaves(t0, t1, r0, r1)) return;
+    const mid = (t0 + t1) / 2, rm = read(mid);
+    levels.push(mid);
+    visit(t0, mid, r0, rm, depth + 1);
+    visit(mid, t1, rm, r1, depth + 1);
+  };
+  visit(0, 1, read(0), read(1), 0);
+  levels.sort((p, q) => p - q);
+  const xy = new Float64Array(2 + levels.length * count * 2);
+  xy[0] = cx; xy[1] = cy;
+  levels.forEach((t, k) => {
+    for (let i = 0; i < count; i++) {
+      // The outline's own points on the last ring, exactly.
+      const [x, y] = t === 1 ? [ring[i * 2]!, ring[i * 2 + 1]!] : at(i, t);
+      xy[2 + (k * count + i) * 2] = x; xy[2 + (k * count + i) * 2 + 1] = y;
+    }
+  });
+  const tris: number[] = [];
+  const v = (k: number, i: number): number => 1 + k * count + (i % count);
+  for (let i = 0; i < count; i++) tris.push(0, v(0, i), v(0, i + 1));
+  for (let k = 0; k + 1 < levels.length; k++) {
+    for (let i = 0; i < count; i++) tris.push(v(k, i), v(k + 1, i), v(k + 1, i + 1), v(k, i), v(k + 1, i + 1), v(k, i + 1));
+  }
+  return { xy, tris: Uint32Array.from(tris) };
+}
+
+/** A strip's or a fan's triangles on the plan alone, counter-clockwise (seen from above), nothing refined: the far level's and a road just built's
+ *  (`networkFarRoads.ts`, `roadStandIn.ts`); null for another shape or none. */
+export function flatTriangles(g: Geom): { xy: Float64Array; tris: Uint32Array } | null {
+  let made: { xy: Float64Array; tris: Uint32Array };
+  if (g.kind === 'strip') made = ladderTriangles({ a: g.a, b: g.b });
+  else if (g.kind === 'fan') made = fanTriangles(g.cx, g.cy, g.ring, FLAT) ?? earTriangles(g.ring);
+  else if (g.kind === 'poly') made = earTriangles(g.ring);
+  else return null;
+  const kept: number[] = [];
+  for (let t = 0; t + 2 < made.tris.length; t += 3) {
+    const a = made.tris[t]! * 2, b = made.tris[t + 1]! * 2, c = made.tris[t + 2]! * 2;
+    const twice = (made.xy[b]! - made.xy[a]!) * (made.xy[c + 1]! - made.xy[a + 1]!) - (made.xy[b + 1]! - made.xy[a + 1]!) * (made.xy[c]! - made.xy[a]!);
+    if (Math.abs(twice) <= LEAST_AREA) continue;
+    if (twice > 0) kept.push(made.tris[t]!, made.tris[t + 1]!, made.tris[t + 2]!);
+    else kept.push(made.tris[t]!, made.tris[t + 2]!, made.tris[t + 1]!);
+  }
+  return kept.length ? { xy: made.xy, tris: Uint32Array.from(kept) } : null;
+}
+
+/** A surface with nothing to refine: a fan of one ring. */
+const FLAT: Sampler = { size: 1, tolerance: [Infinity], floor: [Infinity], sample(_x, _y, out) { out[0] = 0; } };
+
+/** A plate's own outline cut by ear clipping (earcut). */
+function earTriangles(ring: ArrayLike<number>): { xy: Float64Array; tris: Uint32Array } {
+  const xy = Float64Array.from(ring);
+  return { xy, tris: Uint32Array.from(earcut(xy, undefined, 2)) };
+}
+
+/** Twice the summed signed area of triangles over a flat [x, y, ...] list; positive means counter-clockwise. */
+function trianglesArea(flat: ArrayLike<number>, tris: ArrayLike<number>): number {
+  let sum = 0;
+  for (let i = 0; i + 2 < tris.length; i += 3) {
+    const a = tris[i]! * 2, b = tris[i + 1]! * 2, c = tris[i + 2]! * 2;
+    const ax = flat[a]!, ay = flat[a + 1]!;
+    sum += (flat[b]! - ax) * (flat[c + 1]! - ay) - (flat[b + 1]! - ay) * (flat[c]! - ax);
+  }
+  return sum;
+}
+
+/** Twice the signed area of a closed outline of x, y pairs; positive means counter-clockwise. */
+function ringArea(ring: ArrayLike<number>): number {
+  const count = ring.length / 2;
+  let sum = 0;
+  for (let i = 0; i < count; i++) {
+    const j = (i + 1) % count;
+    sum += ring[i * 2]! * ring[j * 2 + 1]! - ring[j * 2]! * ring[i * 2 + 1]!;
+  }
+  return sum;
+}
