+++ b/src/render/roads/junctionPiece.ts
@@ -0,0 +1,279 @@
+import type { Vec2 } from '@core/vec2';
+import type { NodeId } from '@world/ids';
+import type { Network } from '@world/network';
+import { Level, type SurfaceLevel } from '@world/roadTypes';
+import { type Junction, type Leg } from '@world/junction/types';
+import { mouthLeft, mouthRight } from '@world/junction/legs';
+import { nodeCap, nodeCentre } from '@world/junction/polygon';
+import { m } from '@world/units';
+import type { Chain } from '../mesh/stripShape';
+import { FIXED, WALL_A, WALL_B } from './pieceGeom';
+import { FAR_OUTER, type FarShape, type Shape } from './segmentPiece';
+import { EDGES_SLOT } from '../roadSurfaceReads';
+
+/**
+ * # A JUNCTION'S SURFACES, FROM ITS OWN OUTLINES ALONE
+ *
+ * A junction is solved at each surface level (`world/junction/levels.ts`): its legs' mouths, cut across each road at its trim, joined by its corners
+ * (a kerb's return, a squared footway, a taper). Its surfaces are made from those outlines and nothing else:
+ * - the carriageway's plate, its outline at the carriageway's level (`pieceGeom.ts` fan), with the cap over the node where every leg leaves on one
+ *   side (`junction/polygon.ts` nodeCap) taken in as the farther of the two along each ray from the middle;
+ * - each band (the kerb's face, the footway, the verge) at each corner: the strip between the corner's run at the band's inner level and at its outer
+ *   one, from leg to leg. Its ends are the mouths' points at the two levels, where the road's own strips end (`segmentPiece.ts`). Every run of a
+ *   corner carries the same stations, each point's share of the way round the corner (`cornerChains`), so each band is a ladder of quads: two
+ *   bands meet on the same vertices along the run they share, and no fan from one point of a run folds over itself where the other run curves
+ *   away from it (a squared footway round a kerb's return).
+ * No outline is ever united with another's or cut by it.
+ */
+
+/** How far a ring's point may stand from a mouth's and be it. */
+const MOUTH_MATCH = m(0.02);
+
+/** The bands between two levels at a junction's corners: what each is drawn as, its inner level and its outer one. */
+const BANDS: readonly (readonly [string, SurfaceLevel, SurfaceLevel])[] = [
+  ['kerb', Level.Asphalt as SurfaceLevel, Level.Curb as SurfaceLevel],
+  ['footway', Level.Curb as SurfaceLevel, Level.Sidewalk as SurfaceLevel],
+  ['verge', Level.Sidewalk as SurfaceLevel, Level.Casing as SurfaceLevel],
+];
+
+/** Every shape of a junction's surfaces (its paint aside, `roadSurfaceInputs.ts`). */
+export function junctionShapes(net: Network, node: NodeId): Shape[] {
+  const byLevel = net.junctions.get(node);
+  if (!byLevel) return [];
+  const out: Shape[] = [];
+  const carriageway = byLevel.get(Level.Asphalt as SurfaceLevel);
+  if (carriageway && !carriageway.ring.isEmpty && carriageway.legs.length > 0) {
+    const plate = plateOf(carriageway);
+    if (plate) out.push({ slot: 'asphalt', geom: { kind: 'fan', cx: plate.cx, cy: plate.cy, ring: plate.ring, walls: plate.walls, plate: true } });
+  }
+  const lead = carriageway && !carriageway.ring.isEmpty ? carriageway : CORNER_LEVELS.map((level) => byLevel.get(level)).find((j) => j && !j.ring.isEmpty);
+  if (lead) {
+    const n = lead.legs.length;
+    for (let k = 0; k < n; k++) {
+      const chains = cornerChains(byLevel, lead, lead.legs[k]!, lead.legs[(k + 1) % n]!, CORNER_LEVELS);
+      for (const [slot, innerLevel, outerLevel] of BANDS) {
+        const a = chains.get(innerLevel), b = chains.get(outerLevel);
+        if (a && b) out.push({ slot, geom: { kind: 'strip', a, b, group: FIXED, walls: WALL_A | WALL_B } });
+      }
+    }
+  }
+  // The footway's outer edge, what the verge falls from: the footway's level's corners.
+  const sidewalk = byLevel.get(Level.Sidewalk as SurfaceLevel);
+  if (sidewalk && !sidewalk.ring.isEmpty) {
+    const n = sidewalk.legs.length;
+    for (let k = 0; k < n; k++) {
+      const run = cornerRun(sidewalk, sidewalk.legs[k]!, sidewalk.legs[(k + 1) % n]!);
+      if (run) out.push({ slot: EDGES_SLOT, geom: { kind: 'edge', xy: flat(run) } });
+    }
+  }
+  return out;
+}
+
+/** A junction at the network's far level (`networkFarRoadsBuild.ts`): its carriageway's plate (the same fan as its detail's), and at each corner the
+ *  strip from the carriageway's run to its outermost level's run (`FAR_OUTER`), from mouth to mouth, where the roads' far strips end. */
+export function junctionFarShapes(net: Network, node: NodeId): FarShape[] {
+  const byLevel = net.junctions.get(node);
+  const carriageway = byLevel?.get(Level.Asphalt as SurfaceLevel);
+  if (!byLevel || !carriageway || carriageway.ring.isEmpty || carriageway.legs.length === 0) return [];
+  const out: FarShape[] = [];
+  const plate = plateOf(carriageway);
+  if (plate) out.push({ layer: 1, geom: { kind: 'fan', cx: plate.cx, cy: plate.cy, ring: plate.ring, walls: plate.walls } });
+  const outer = FAR_OUTER.find((level) => { const j = byLevel.get(level); return j !== undefined && !j.ring.isEmpty; });
+  if (outer !== undefined) {
+    const n = carriageway.legs.length;
+    for (let k = 0; k < n; k++) {
+      const chains = cornerChains(byLevel, carriageway, carriageway.legs[k]!, carriageway.legs[(k + 1) % n]!, [Level.Asphalt as SurfaceLevel, outer]);
+      const a = chains.get(Level.Asphalt as SurfaceLevel), b = chains.get(outer);
+      if (a && b) out.push({ layer: 0, geom: { kind: 'strip', a, b, group: FIXED, walls: 0 } });
+    }
+  }
+  return out;
+}
+
+/** Every level a corner's bands run between. */
+const CORNER_LEVELS: readonly SurfaceLevel[] = [Level.Asphalt as SurfaceLevel, Level.Curb as SurfaceLevel, Level.Sidewalk as SurfaceLevel, Level.Casing as SurfaceLevel];
+
+/** A level's outline, counter-clockwise. */
+function ringOf(j: Junction): Vec2[] {
+  const points = j.ring.flatten();
+  let area = 0;
+  for (let i = 0; i < points.length; i++) {
+    const p = points[i]!, q = points[(i + 1) % points.length]!;
+    area += p.x * q.y - q.x * p.y;
+  }
+  return area < 0 ? points.reverse() : points;
+}
+
+/** The index of the ring's point at `p`; -1 where none is. */
+function indexAt(ring: readonly Vec2[], p: Vec2): number {
+  let best = -1, bestD = MOUTH_MATCH;
+  ring.forEach((q, i) => { const d = Math.hypot(q.x - p.x, q.y - p.y); if (d <= bestD) { bestD = d; best = i; } });
+  return best;
+}
+
+/** A leg of a level by its road and its end (`Leg.plusSide`: which way round it leaves the node). */
+function legLike(j: Junction, leg: Leg): number {
+  return j.legs.findIndex((l) => l.seg === leg.seg && l.plusSide === leg.plusSide);
+}
+
+/** A level's corner from leg `from`'s mouth to the next leg `to`'s (`from`'s +nrm side to `to`'s -nrm side, counter-clockwise), its outline's own
+ *  points; null where the level lacks either leg or the outline either mouth. */
+function cornerRun(j: Junction, from: Leg, to: Leg): Vec2[] | null {
+  const i = legLike(j, from), k = legLike(j, to);
+  if (i < 0 || k < 0) return null;
+  const ring = ringOf(j);
+  const start = indexAt(ring, mouthLeft(j.legs[i]!, j.trims[i]!)), end = indexAt(ring, mouthRight(j.legs[k]!, j.trims[k]!));
+  if (start < 0 || end < 0) return null;
+  const out: Vec2[] = [];
+  for (let t = start; ; t = (t + 1) % ring.length) {
+    out.push(ring[t]!);
+    if (t === end || out.length > ring.length) break;
+  }
+  return out.length >= 2 ? out : null;
+}
+
+/** The carriageway's plate: its outline, its middle, and its edges' walls (every edge but a mouth's, where a road's strip carries on). */
+function plateOf(j: Junction): { cx: number; cy: number; ring: Float64Array; walls: Uint8Array } | null {
+  let ring = ringOf(j);
+  if (ring.length < 3) return null;
+  const centre = nodeCentre(j.legs);
+  const mouths = j.legs.map((leg, i) => ({ right: mouthRight(leg, j.trims[i]!), left: mouthLeft(leg, j.trims[i]!) }));
+  // Every leg on one side: the cap over the node, taken in along each ray where it stands farther than the outline, never past a mouth.
+  const cap = nodeCap(j.legs, centre);
+  if (cap) ring = withCap(ring, cap.flatten(), centre, mouths);
+  const walls = new Uint8Array(ring.length).fill(1);
+  for (let i = 0; i < ring.length; i++) {
+    const p = ring[i]!, q = ring[(i + 1) % ring.length]!;
+    if (mouths.some((mo) => near(p, mo.right) && near(q, mo.left))) walls[i] = 0;
+  }
+  return { cx: centre.x, cy: centre.y, ring: flat(ring), walls };
+}
+
+const near = (p: Vec2, q: Vec2): boolean => Math.hypot(p.x - q.x, p.y - q.y) <= MOUTH_MATCH;
+
+/** Points as x, y pairs. */
+function flat(points: readonly Vec2[]): Float64Array {
+  const out = new Float64Array(points.length * 2);
+  points.forEach((p, i) => { out[i * 2] = p.x; out[i * 2 + 1] = p.y; });
+  return out;
+}
+
+/** How far along the ray from `c` at angle `a` an outline seen whole from `c` lies; 0 where the ray meets none of it. */
+function reachAlong(ring: readonly Vec2[], c: Vec2, a: number): number {
+  const dx = Math.cos(a), dy = Math.sin(a);
+  let best = 0;
+  for (let i = 0; i < ring.length; i++) {
+    const p = ring[i]!, q = ring[(i + 1) % ring.length]!;
+    const ex = q.x - p.x, ey = q.y - p.y;
+    const den = dx * ey - dy * ex;
+    if (Math.abs(den) < 1e-12) continue;
+    const t = ((p.x - c.x) * ey - (p.y - c.y) * ex) / den;
+    const u = ((p.x - c.x) * dy - (p.y - c.y) * dx) / den;
+    if (t > 0 && u >= -1e-9 && u <= 1 + 1e-9) best = Math.max(best, t);
+  }
+  return best;
+}
+
+/** The outline and the cap as one, each ray from the middle reaching the farther of the two (both seen whole from it: the farther along every
+ *  ray is the outline of the two together); within a mouth's angle the outline alone, so the plate stops on the mouth line. */
+function withCap(ring: readonly Vec2[], cap: readonly Vec2[], c: Vec2, mouths: readonly { right: Vec2; left: Vec2 }[]): Vec2[] {
+  const angle = (p: Vec2): number => Math.atan2(p.y - c.y, p.x - c.x);
+  const wedges = mouths.map((mo) => [angle(mo.right), angle(mo.left)] as const);
+  const inMouth = (a: number): boolean => wedges.some(([r, l]) => {
+    const span = ((l - r) % (2 * Math.PI) + 2 * Math.PI) % (2 * Math.PI);
+    const off = ((a - r) % (2 * Math.PI) + 2 * Math.PI) % (2 * Math.PI);
+    return off <= span + 1e-9;
+  });
+  const angles = [...ring.map(angle), ...cap.map(angle)].sort((p, q) => p - q);
+  const out: Vec2[] = [];
+  for (const a of angles) {
+    const own = ring.find((p) => Math.abs(angle(p) - a) < 1e-12);
+    const r = reachAlong(ring, c, a);
+    const far = inMouth(a) ? r : Math.max(r, reachAlong(cap, c, a));
+    const p = own && far <= r + 1e-9 ? own : { x: c.x + Math.cos(a) * far, y: c.y + Math.sin(a) * far };
+    const last = out[out.length - 1];
+    if (!last || Math.hypot(last.x - p.x, last.y - p.y) > 1e-6) out.push(p);
+  }
+  return out;
+}
+
+/** The point a corner's runs are matched round (`pairUp`): the kerb's return's centre, else where the two legs' edges meet; null for neither. */
+function pivotOf(j: Junction, leg: Leg): Vec2 | null {
+  const i = legLike(j, leg);
+  const corner = j.corners.find((c) => c.i === i);
+  return corner?.fillet?.c ?? corner?.x ?? null;
+}
+
+/** How near two shares of a corner are taken as one station. */
+const SHARE_EPS = 1e-9;
+
+/** Each point's share of the way along a run by its angle round `pivot` (the kerb's return's centre, which the runs of every level wrap round: a
+ *  squared footway's corner meets the return's middle); null where the angles do not go one way round. */
+function sharesByAngle(run: readonly Vec2[], pivot: Vec2 | null): number[] | null {
+  if (!pivot) return null;
+  const turns = [0];
+  for (let i = 1; i < run.length; i++) {
+    let d = Math.atan2(run[i]!.y - pivot.y, run[i]!.x - pivot.x) - Math.atan2(run[i - 1]!.y - pivot.y, run[i - 1]!.x - pivot.x);
+    while (d <= -Math.PI) d += 2 * Math.PI;
+    while (d > Math.PI) d -= 2 * Math.PI;
+    turns.push(turns[i - 1]! + d);
+  }
+  const total = turns[turns.length - 1]!;
+  if (Math.abs(total) < 1e-6) return null;
+  const share = turns.map((t) => t / total);
+  for (let i = 1; i < share.length; i++) if (share[i]! < share[i - 1]! - 1e-9) return null;
+  return share.map((t, i) => (i === share.length - 1 ? 1 : Math.max(0, Math.min(1, t))));
+}
+
+/** Each point's share of the way along a run by its length. */
+function sharesByLength(run: readonly Vec2[]): number[] {
+  const out = [0];
+  for (let i = 1; i < run.length; i++) out.push(out[i - 1]! + Math.hypot(run[i]!.x - run[i - 1]!.x, run[i]!.y - run[i - 1]!.y));
+  const total = Math.max(1e-9, out[out.length - 1]!);
+  return out.map((l, i) => (i === out.length - 1 ? 1 : l / total));
+}
+
+/** A run's length. */
+function runLength(run: readonly Vec2[]): number {
+  let l = 0;
+  for (let i = 1; i < run.length; i++) l += Math.hypot(run[i]!.x - run[i - 1]!.x, run[i]!.y - run[i - 1]!.y);
+  return l;
+}
+
+/**
+ * A corner's runs at `levels` (from leg `from`'s mouth to the next leg `to`'s) as chains with the same stations: each run's points placed by their
+ * share of the way round (`sharesByAngle` round the corner's pivot, by length where the angles do not go one way), and every run given a point at
+ * every share any of them has, on its own line. A strip between two of them is a ladder of quads, station to station; two strips sharing a run share
+ * its vertices; a run's own points (its mouths' among them) are kept as they are.
+ */
+function cornerChains(byLevel: ReadonlyMap<SurfaceLevel, Junction>, lead: Junction, from: Leg, to: Leg, levels: readonly SurfaceLevel[]): Map<SurfaceLevel, Chain> {
+  const pivot = pivotOf(lead, from);
+  const runs: { level: SurfaceLevel; run: Vec2[]; share: number[] }[] = [];
+  for (const level of levels) {
+    const j = byLevel.get(level);
+    if (!j || j.ring.isEmpty) continue;
+    const run = cornerRun(j, from, to);
+    if (run) runs.push({ level, run, share: sharesByAngle(run, pivot) ?? sharesByLength(run) });
+  }
+  const all = runs.flatMap((r) => r.share).sort((p, q) => p - q);
+  const stations: number[] = [];
+  for (const t of all) if (!stations.length || t - stations[stations.length - 1]! > SHARE_EPS) stations.push(t);
+  const scale = Math.max(1e-6, runs.reduce((sum, r) => sum + runLength(r.run), 0) / Math.max(1, runs.length));
+  const out = new Map<SurfaceLevel, Chain>();
+  for (const { level, run, share } of runs) {
+    const xy = new Float64Array(stations.length * 2);
+    let i = 0;
+    stations.forEach((t, k) => {
+      while (i < share.length - 2 && share[i + 1]! < t - SHARE_EPS) i++;
+      const t0 = share[i]!, t1 = share[i + 1]!;
+      // A run's own point where its share is the station's; else on its edge, by the share between its two points.
+      const own = Math.abs(t - t0) <= SHARE_EPS ? i : Math.abs(t - t1) <= SHARE_EPS ? i + 1 : -1;
+      if (own >= 0) { xy[k * 2] = run[own]!.x; xy[k * 2 + 1] = run[own]!.y; return; }
+      const u = t1 - t0 > 1e-12 ? (t - t0) / (t1 - t0) : 0;
+      xy[k * 2] = run[i]!.x + (run[i + 1]!.x - run[i]!.x) * u;
+      xy[k * 2 + 1] = run[i]!.y + (run[i + 1]!.y - run[i]!.y) * u;
+    });
+    out.set(level, { xy, s: Float64Array.from(stations.map((t) => t * scale)) });
+  }
+  return out;
+}
diff --git a/src/render/roads/pieceGeom.ts b/src/render/roads/pieceGeom.ts
