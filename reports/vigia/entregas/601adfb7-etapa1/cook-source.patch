+    const byBone = new Map<number, number>();
+    for (let k = 0; k < 3; k++) {
+      const v = index[t * 3 + k]!;
+      for (let j = 0; j < 4; j++) {
+        const weight = (source.weights[v * 4 + j] ?? 0) * bary[k]!;
+        if (weight > 0) byBone.set(source.joints[v * 4 + j]!, (byBone.get(source.joints[v * 4 + j]!) ?? 0) + weight);
+      }
+    }
+    const heaviest = [...byBone].sort((p1, p2) => p2[1] - p1[1]).slice(0, 4);
+    const total = heaviest.reduce((s1, [, w]) => s1 + w, 0) || 1;
+    heaviest.forEach(([bone, w], j) => { outJoints[i * 4 + j] = bone; outWeights[i * 4 + j] = w / total; });
+  }
+
+  // ---- normals from the first far level, by area
+  const normals = new Float32Array(n * 3);
+  const first = outLevels[0]!;
+  for (let k = 0; k < first.length; k += 3) {
+    const a = first[k]!, b = first[k + 1]!, c = first[k + 2]!;
+    const ux = outPositions[b * 3]! - outPositions[a * 3]!, uy = outPositions[b * 3 + 1]! - outPositions[a * 3 + 1]!, uz = outPositions[b * 3 + 2]! - outPositions[a * 3 + 2]!;
+    const vx = outPositions[c * 3]! - outPositions[a * 3]!, vy = outPositions[c * 3 + 1]! - outPositions[a * 3 + 1]!, vz = outPositions[c * 3 + 2]! - outPositions[a * 3 + 2]!;
+    const fx = uy * vz - uz * vy, fy = uz * vx - ux * vz, fz = ux * vy - uy * vx;
+    for (const v of [a, b, c]) { normals[v * 3] = normals[v * 3]! + fx; normals[v * 3 + 1] = normals[v * 3 + 1]! + fy; normals[v * 3 + 2] = normals[v * 3 + 2]! + fz; }
+  }
+  for (let v = 0; v < n; v++) {
+    const l = Math.hypot(normals[v * 3]!, normals[v * 3 + 1]!, normals[v * 3 + 2]!) || 1;
+    normals[v * 3] = normals[v * 3]! / l; normals[v * 3 + 1] = normals[v * 3 + 1]! / l; normals[v * 3 + 2] = normals[v * 3 + 2]! / l;
+  }
+  return { positions: outPositions, normals, personColor: outColour, joints: outJoints, weights: outWeights, levels: outLevels, cells: dims, netTriangles: faces.length / 3 };
+}
diff --git a/src/dev/peopleCook/visibility.ts b/src/dev/peopleCook/visibility.ts
new file mode 100644
index 00000000..0d360866
--- /dev/null
+++ b/src/dev/peopleCook/visibility.ts
@@ -0,0 +1,269 @@
+import {
+  BufferAttribute, BufferGeometry, Color, DoubleSide, OrthographicCamera, Quaternion, RGBAFormat, Scene, ShaderMaterial, SkinnedMesh,
+  UnsignedByteType, Vector3, WebGLRenderTarget, type Bone, type Object3D, type WebGLRenderer,
+} from 'three';
+
+/**
+ * THE TRIANGLES NOBODY CAN SEE: every opaque triangle of the dressed body (skin and the garments that cover it) drawn with its own number
+ * from many directions round it and in several postures (standing, arms down, walking, seated, reaching, arms up), as Simplygon's
+ * visibility culling does with a set of cameras (https://documentation.simplygon.com/SimplygonSDK_10.4.132.0/unity/tutorials/visibility.html).
+ * A candidate triangle no view ever shows is hidden, unless it lies within `BAND` of a shown triangle of its own part (the skin under a
+ * cuff, a collar, a hem moves out as the body moves). Hair, brows, lashes, eyes and see-through items hide nothing and are never cut.
+ */
+
+/** Directions round the body, spread evenly over the sphere (a Fibonacci lattice). */
+const DIRECTIONS = 64;
+/** Texels of each view: about 1.2 mm a texel over the 2.4 m frame. */
+const SIZE = 2048;
+/** A hidden triangle this close to a shown one of its own part is kept: the slack a sleeve or a hem has over the moving body, beyond the
+ *  postures drawn. Three centimetres kept the skin round a dress's armholes and hem, and the simplified dress let it through (mh_48). */
+const BAND = 0.015;
+/** Half the side of the square each view takes in, metres, about the body's middle: wide enough for arms out and a seated body. */
+const REACH = 1.2;
+
+const VERTEX = /* glsl */ `
+#include <common>
+#include <skinning_pars_vertex>
+attribute vec3 tid;
+varying vec3 vId;
+void main() {
+  vId = tid;
+  #include <skinbase_vertex>
+  #include <begin_vertex>
+  #include <skinning_vertex>
+  #include <project_vertex>
+}`;
+const FRAGMENT = /* glsl */ `
+precision highp float;
+varying vec3 vId;
+void main() { gl_FragColor = vec4(vId, 1.0); }`;
+
+/** `bone` turned so its child's head lies along `direction` (world); the rest of the skeleton follows. */
+function aim(bone: Bone, child: Bone, direction: Vector3): void {
+  bone.updateWorldMatrix(true, false);
+  child.updateWorldMatrix(true, false);
+  const from = new Vector3().setFromMatrixPosition(bone.matrixWorld);
+  const to = new Vector3().setFromMatrixPosition(child.matrixWorld);
+  const now = to.sub(from).normalize();
+  const delta = new Quaternion().setFromUnitVectors(now, direction.clone().normalize());
+  const parentWorld = new Quaternion();
+  bone.parent?.getWorldQuaternion(parentWorld);
+  const world = new Quaternion();
+  bone.getWorldQuaternion(world);
+  bone.quaternion.copy(parentWorld.invert().multiply(delta).multiply(world));
+  bone.updateWorldMatrix(false, true);
+}
+
+/** A posture: each limb's bone aimed along a world direction, x towards the limb's own side (+1 or -1), z forward (the body faces +z). */
+type Posture = readonly (readonly [string, string, (side: number) => Vector3])[];
+const ARMS_DOWN: Posture = [
+  ['UpperArm', 'Forearm', (s) => new Vector3(0.15 * s, -1, 0)], ['Forearm', 'Hand', (s) => new Vector3(0.1 * s, -1, 0.05)],
+];
+/** The first postures of `POSTURES` are a figure standing or walking. */
+const STANDING = 3;
+const POSTURES: readonly Posture[] = [
+  [],
+  ARMS_DOWN,
+  // Walking: one leg forward, the other back, the arms swung against them.
+  [['Thigh', 'Calf', (s) => new Vector3(0, -1, s > 0 ? 0.55 : -0.35)], ['Calf', 'Foot', (s) => new Vector3(0, -1, s > 0 ? 0.1 : -0.6)],
+    ['UpperArm', 'Forearm', (s) => new Vector3(0.12 * s, -1, s > 0 ? -0.4 : 0.45)], ['Forearm', 'Hand', (s) => new Vector3(0.1 * s, -1, 0.35)]],
+  // Seated: thighs forward, shins down, hands on the lap or a wheel.
+  [['Thigh', 'Calf', (s) => new Vector3(0.1 * s, -0.15, 1)], ['Calf', 'Foot', () => new Vector3(0, -1, 0.1)],
+    ['UpperArm', 'Forearm', (s) => new Vector3(0.15 * s, -1, 0.5)], ['Forearm', 'Hand', (s) => new Vector3(0.05 * s, -0.3, 1)]],
+  // Reaching forward: a rider's grips, a box carried, a phone held up.
+  [['UpperArm', 'Forearm', (s) => new Vector3(0.1 * s, -0.2, 1)], ['Forearm', 'Hand', () => new Vector3(0, 0.2, 1)],
+    ['Thigh', 'Calf', (s) => new Vector3(0.25 * s, -1, 0.2)]],
+  // Arms up (a fright, a cheer): the sides and the waist under a shirt.
+  [['UpperArm', 'Forearm', (s) => new Vector3(0.35 * s, 1, 0.1)], ['Forearm', 'Hand', (s) => new Vector3(0.1 * s, 1, 0)]],
+];
+
+/** The bones of the cooked skeleton by name (`Bip01_L_UpperArm`...). */
+function bonesOf(root: Object3D): Map<string, Bone> {
+  const out = new Map<string, Bone>();
+  root.traverse((o) => { if ((o as Bone).isBone) out.set(o.name, o as Bone); });
+  return out;
+}
+
+/** Puts `root`'s skeleton in `posture` (from the bind: `rest` holds every bone's own rotation). */
+function pose(root: Object3D, bones: Map<string, Bone>, rest: Map<Bone, Quaternion>, posture: Posture): void {
+  for (const [bone, q] of rest) bone.quaternion.copy(q);
+  root.updateMatrixWorld(true);
+  for (const [name, childName, direction] of posture) {
+    for (const side of ['L', 'R']) {
+      const bone = bones.get(`Bip01_${side}_${name}`), child = bones.get(`Bip01_${side}_${childName}`);
+      if (!bone || !child) continue;
+      bone.updateWorldMatrix(true, false);
+      const x = new Vector3().setFromMatrixPosition(bone.matrixWorld).x;
+      aim(bone, child, direction(Math.sign(x) || (side === 'L' ? 1 : -1)));
+    }
+  }
+  root.updateMatrixWorld(true);
+}
+
+export interface VisibilityInput {
+  readonly renderer: WebGLRenderer;
+  /** The rig's scene: the root holding the bones and `mesh`. */
+  readonly scene: Object3D;
+  readonly mesh: SkinnedMesh;
+  /** Every triangle of the dressed body. */
+  readonly index: Uint32Array;
+  /** Each triangle's part (0 the body, k the k-th item worn) and whether it is opaque cover: drawn into the views and cut where unseen. */
+  readonly part: Int32Array;
+  readonly opaque: Uint8Array;
+  /** The body's height, metres: the views are centred half way up. */
+  readonly height: number;
+}
+
+export interface Visibility {
+  /** The triangles kept, in their order. */
+  readonly index: Uint32Array;
+  /** Of `index`, the opaque triangles no standing or walking posture shows (no band): what a coarser level may drop (`lodLadder.ts`). */
+  readonly unseenStanding: Uint8Array;
+  /** Of `index`, each triangle's part and whether it is opaque cover (`VisibilityInput`). */
+  readonly parts: Int32Array;
+  readonly opaque: Uint8Array;
+  /** Triangles cut, of each part (by `part`), and of all. */
+  readonly cutByPart: ReadonlyMap<number, number>;
+  readonly cut: number;
+  /** Triangles never seen but kept inside the band. */
+  readonly banded: number;
+  readonly views: number;
+}
+
+/** The dressed body less every opaque triangle no view and posture shows (outside the band of its own part's shown ones). */
+export function cullHidden(input: VisibilityInput): Visibility {
+  const { renderer, scene, mesh, index, part, opaque, height } = input;
+  const triangles = index.length / 3;
+  if (triangles >= 1 << 24) throw new Error('too many triangles to number in a colour');
+  const position = mesh.geometry.getAttribute('position') as BufferAttribute;
+  const skinIndex = mesh.geometry.getAttribute('skinIndex') as BufferAttribute;
+  const skinWeight = mesh.geometry.getAttribute('skinWeight') as BufferAttribute;
+  // Each opaque triangle on vertices of its own, numbered t + 1 in its colour (0 is the empty background).
+  const drawn: number[] = [];
+  for (let t = 0; t < triangles; t++) if (opaque[t]) drawn.push(t);
+  const n = drawn.length * 3;
+  const p = new Float32Array(n * 3), id = new Float32Array(n * 3), si = new Uint16Array(n * 4), sw = new Float32Array(n * 4);
+  drawn.forEach((t, k) => {
+    const number = t + 1;
+    for (let c = 0; c < 3; c++) {
+      const v = index[t * 3 + c]!, o = k * 3 + c;
+      p[o * 3] = position.getX(v); p[o * 3 + 1] = position.getY(v); p[o * 3 + 2] = position.getZ(v);
+      id[o * 3] = (number & 255) / 255; id[o * 3 + 1] = ((number >> 8) & 255) / 255; id[o * 3 + 2] = ((number >> 16) & 255) / 255;
+      for (let j = 0; j < 4; j++) { si[o * 4 + j] = skinIndex.getComponent(v, j); sw[o * 4 + j] = skinWeight.getComponent(v, j); }
+    }
+  });
+  const geometry = new BufferGeometry();
+  geometry.setAttribute('position', new BufferAttribute(p, 3));
+  geometry.setAttribute('tid', new BufferAttribute(id, 3));
+  geometry.setAttribute('skinIndex', new BufferAttribute(si, 4));
+  geometry.setAttribute('skinWeight', new BufferAttribute(sw, 4));
+  const material = new ShaderMaterial({ vertexShader: VERTEX, fragmentShader: FRAGMENT, side: DoubleSide });
+  const ids = new SkinnedMesh(geometry, material);
+  ids.frustumCulled = false;
+  ids.bind(mesh.skeleton, mesh.bindMatrix);
+  const visibleMesh = mesh.visible;
+  mesh.visible = false;
+  const parent = mesh.parent!;
+  parent.add(ids);
+  const stage = new Scene();
+  const owner = scene.parent;
+  stage.add(scene);
+  const bones = bonesOf(scene);
+  const rest = new Map<Bone, Quaternion>([...bones.values()].map((b) => [b, b.quaternion.clone()]));
+  const target = new WebGLRenderTarget(SIZE, SIZE, { format: RGBAFormat, type: UnsignedByteType, depthBuffer: true, stencilBuffer: false, generateMipmaps: false });
+  const pixels = new Uint8Array(SIZE * SIZE * 4);
+  const seen = new Uint8Array(triangles);
+  // Seen standing, arms down or walking (the first three postures): a figure seated or reaching is seen near, at the finest level.
+  const seenStanding = new Uint8Array(triangles);
+  const camera = new OrthographicCamera(-REACH, REACH, REACH, -REACH, 0.01, 20);
+  const centre = new Vector3(0, height / 2, 0);
+  const previousTarget = renderer.getRenderTarget();
+  const previousClear = new Color();
+  renderer.getClearColor(previousClear);
+  const previousAlpha = renderer.getClearAlpha();
+  let views = 0;
+  try {
+    renderer.setRenderTarget(target);
+    renderer.setClearColor(0x000000, 1);
+    for (const [p, posture] of POSTURES.entries()) {
+      pose(scene, bones, rest, posture);
+      for (let k = 0; k < DIRECTIONS; k++) {
+        // The Fibonacci lattice: even steps in height, the golden angle round.
+        const y = 1 - (2 * (k + 0.5)) / DIRECTIONS, r = Math.sqrt(1 - y * y), phi = k * Math.PI * (3 - Math.sqrt(5));
+        const direction = new Vector3(Math.cos(phi) * r, y, Math.sin(phi) * r);
+        camera.position.copy(centre).addScaledVector(direction, 10);
+        camera.up.set(Math.abs(y) > 0.99 ? 1 : 0, Math.abs(y) > 0.99 ? 0 : 1, 0);
+        camera.lookAt(centre);
+        camera.updateMatrixWorld(true);
+        renderer.clear(true, true, false);
+        renderer.render(stage, camera);
+        renderer.readRenderTargetPixels(target, 0, 0, SIZE, SIZE, pixels);
+        for (let i = 0; i < pixels.length; i += 4) {
+          const number = pixels[i]! | (pixels[i + 1]! << 8) | (pixels[i + 2]! << 16);
+          if (number) { seen[number - 1] = 1; if (p < STANDING) seenStanding[number - 1] = 1; }
+        }
+        views++;
+      }
+    }
+  } finally {
+    pose(scene, bones, rest, []);
+    renderer.setRenderTarget(previousTarget);
+    renderer.setClearColor(previousClear, previousAlpha);
+    target.dispose();
+    material.dispose();
+    geometry.dispose();
+    parent.remove(ids);
+    mesh.visible = visibleMesh;
+    stage.remove(scene);
+    if (owner) owner.add(scene);
+  }
+
+  // The band: a shown triangle's corners, by part, in a grid of BAND cells; an unseen triangle with a corner within BAND of one is kept.
+  const cellOf = (x: number, y: number, z: number): string => `${Math.floor(x / BAND)},${Math.floor(y / BAND)},${Math.floor(z / BAND)}`;
+  const shown = new Map<number, Map<string, number[]>>();
+  for (let t = 0; t < triangles; t++) {
+    if (!opaque[t] || !seen[t]) continue;
+    let grid = shown.get(part[t]!);
+    if (!grid) shown.set(part[t]!, grid = new Map());
+    for (let c = 0; c < 3; c++) {
+      const v = index[t * 3 + c]!;
+      const key = cellOf(position.getX(v), position.getY(v), position.getZ(v));
+      let list = grid.get(key);
+      if (!list) grid.set(key, list = []);
+      list.push(v);
+    }
+  }
+  const near = (t: number): boolean => {
+    const grid = shown.get(part[t]!);
+    if (!grid) return false;
+    for (let c = 0; c < 3; c++) {
+      const v = index[t * 3 + c]!;
+      const x = position.getX(v), y = position.getY(v), z = position.getZ(v);
+      const cx = Math.floor(x / BAND), cy = Math.floor(y / BAND), cz = Math.floor(z / BAND);
+      for (let dx = -1; dx <= 1; dx++) for (let dy = -1; dy <= 1; dy++) for (let dz = -1; dz <= 1; dz++) {
+        for (const w of grid.get(`${cx + dx},${cy + dy},${cz + dz}`) ?? []) {
+          if (Math.hypot(position.getX(w) - x, position.getY(w) - y, position.getZ(w) - z) <= BAND) return true;
+        }
+      }
+    }
+    return false;
+  };
+  const kept: number[] = [];
+  const standing: number[] = [], keptParts: number[] = [], keptOpaque: number[] = [];
+  const cutByPart = new Map<number, number>();
+  let cut = 0, banded = 0;
+  for (let t = 0; t < triangles; t++) {
+    if (opaque[t] && !seen[t]) {
+      if (!near(t)) { cut++; cutByPart.set(part[t]!, (cutByPart.get(part[t]!) ?? 0) + 1); continue; }
+      banded++;
+    }
+    kept.push(index[t * 3]!, index[t * 3 + 1]!, index[t * 3 + 2]!);
+    standing.push(opaque[t] && !seenStanding[t] ? 1 : 0);
+    keptParts.push(part[t]!);
+    keptOpaque.push(opaque[t]!);
+  }
+  return {
+    index: Uint32Array.from(kept), unseenStanding: Uint8Array.from(standing), parts: Int32Array.from(keptParts), opaque: Uint8Array.from(keptOpaque),
+    cutByPart, cut, banded, views,
+  };
+}
diff --git a/src/dev/peopleCook/weld.ts b/src/dev/peopleCook/weld.ts
new file mode 100644
index 00000000..11d7d54c
--- /dev/null
+++ b/src/dev/peopleCook/weld.ts
@@ -0,0 +1,100 @@
+/**
+ * THE DRESSED BODY WELDED: MakeHuman's items come with vertices repeated where nothing tells them apart (the same place, atlas texel,
+ * colour, bones and face moves, a shading normal within `CREASE` of each other) and with cards made two-sided by a second, coincident copy
+ * of every triangle. meshoptimizer cannot simplify a mesh whose vertices are not welded ("for meshes with inconsistent topology or many
+ * seams, such as faceted meshes, it can result in simplifier getting stuck"; https://github.com/zeux/meshoptimizer#simplification), and the
+ * person's material draws both sides of every triangle (`personMaterial.ts`, `DoubleSide`), so the second copy draws nothing the first
+ * does not. Here each group of such vertices becomes one (its normals averaged) and a triangle lying on the corners of another is dropped.
+ */
+
+/** Normals further apart than this stay apart: a crease drawn on purpose (a sole's rim, a collar's fold). */
+const CREASE = Math.cos((45 * Math.PI) / 180);
+/** Positions this close are the same place (a tenth of a millimetre). */
+const PLACE = 1e-4;
+
+export interface WeldInput {
+  readonly positions: Float32Array;
+  readonly normals: Float32Array;
+  readonly atlasUv: Float32Array;
+  readonly personColor: Uint8Array;
+  readonly joints: ArrayLike<number>;
+  readonly weights: ArrayLike<number>;
+  /** Each face expression's moves, three a vertex. */
+  readonly morphs: readonly ArrayLike<number>[];
+  readonly index: Uint32Array;
+  /** A flag a triangle of `index`, carried to the triangles kept. */
+  readonly flags: Uint8Array;
+}
+
+export interface Welded {
+  /** The triangles on the welded vertices, the coincident copies gone. */
+  readonly index: Uint32Array;
+  /** The normals with each welded group's average written into its first vertex. */
+  readonly normals: Float32Array;
+  /** `flags` of the triangles kept, in their order. */
+  readonly flags: Uint8Array;
+  readonly merged: number;
+  readonly duplicates: number;
+}
+
+export function weld(input: WeldInput): Welded {
+  const { positions, atlasUv, personColor, joints, weights, morphs, index } = input;
+  const n = positions.length / 3;
+  const normals = Float32Array.from(input.normals);
+  const placeKey = (v: number): string => `${Math.round(positions[v * 3]! / PLACE)},${Math.round(positions[v * 3 + 1]! / PLACE)},${Math.round(positions[v * 3 + 2]! / PLACE)}`;
+  const same = (a: number, b: number): boolean => {
+    if (Math.abs(atlasUv[a * 2]! - atlasUv[b * 2]!) > 1e-6 || Math.abs(atlasUv[a * 2 + 1]! - atlasUv[b * 2 + 1]!) > 1e-6) return false;
+    for (let k = 0; k < 4; k++) if (personColor[a * 4 + k] !== personColor[b * 4 + k]) return false;
+    for (let k = 0; k < 4; k++) if (joints[a * 4 + k] !== joints[b * 4 + k] || Math.abs(weights[a * 4 + k]! - weights[b * 4 + k]!) > 1e-4) return false;
+    for (const m of morphs) {
+      if (b * 3 + 2 >= m.length || a * 3 + 2 >= m.length) { if (b * 3 + 2 >= m.length !== a * 3 + 2 >= m.length) return false; continue; }
+      for (let c = 0; c < 3; c++) if (Math.abs(m[a * 3 + c]! - m[b * 3 + c]!) > 1e-6) return false;
+    }
+    const dot = input.normals[a * 3]! * input.normals[b * 3]! + input.normals[a * 3 + 1]! * input.normals[b * 3 + 1]! + input.normals[a * 3 + 2]! * input.normals[b * 3 + 2]!;
+    return dot >= CREASE;
+  };
+  // Each vertex the first vertex of its group, by place first.
+  const used = new Uint8Array(n);
+  for (const v of index) used[v] = 1;
+  const byPlace = new Map<string, number[]>();
+  for (let v = 0; v < n; v++) {
+    if (!used[v]) continue;
+    const key = placeKey(v);
+    let list = byPlace.get(key);
+    if (!list) byPlace.set(key, list = []);
+    list.push(v);
+  }
+  const into = new Int32Array(n).map((_, v) => v);
+  let merged = 0;
+  for (const list of byPlace.values()) {
+    if (list.length < 2) continue;
+    const heads: number[] = [];
+    for (const v of list) {
+      const head = heads.find((h) => same(h, v));
+      if (head === undefined) { heads.push(v); continue; }
+      into[v] = head;
+      merged++;
+    }
+    for (const head of heads) {
+      let x = 0, y = 0, z = 0;
+      for (const v of list) if (into[v] === head) { x += input.normals[v * 3]!; y += input.normals[v * 3 + 1]!; z += input.normals[v * 3 + 2]!; }
+      const l = Math.hypot(x, y, z) || 1;
+      normals[head * 3] = x / l; normals[head * 3 + 1] = y / l; normals[head * 3 + 2] = z / l;
+    }
+  }
+  // Triangles on the welded vertices; one lying on the same three places as a triangle already kept is its second side.
+  const out: number[] = [];
+  const flags: number[] = [];
+  const corners = new Set<string>();
+  let duplicates = 0;
+  for (let t = 0; t < index.length; t += 3) {
+    const a = into[index[t]!]!, b = into[index[t + 1]!]!, c = into[index[t + 2]!]!;
+    if (a === b || b === c || a === c) { duplicates++; continue; }
+    const key = [placeKey(a), placeKey(b), placeKey(c)].sort().join('|');
+    if (corners.has(key)) { duplicates++; continue; }
+    corners.add(key);
+    out.push(a, b, c);
+    flags.push(input.flags[t / 3]!);
+  }
+  return { index: Uint32Array.from(out), normals, flags: Uint8Array.from(flags), merged, duplicates };
+}
diff --git a/src/render/people/cookedPerson.ts b/src/render/people/cookedPerson.ts
index d45393bf..5a3a118c 100644
