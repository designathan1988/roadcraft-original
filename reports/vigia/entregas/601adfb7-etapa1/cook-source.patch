+/** Where the ray from `o` along unit `d` first meets triangle abc within `far` (Moller and Trumbore, 1997), or null. */
+function rayTriangle(o: readonly number[], d: readonly number[], a: readonly number[], b: readonly number[], c: readonly number[], far: number): [number, number, number] | null {
+  const e1 = [b[0]! - a[0]!, b[1]! - a[1]!, b[2]! - a[2]!], e2 = [c[0]! - a[0]!, c[1]! - a[1]!, c[2]! - a[2]!];
