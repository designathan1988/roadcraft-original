+const SCRATCH = new Float64Array(4);
+
+/** A point found on a mesh: its triangle, barycentrics and distance. */
+export interface Nearest { readonly triangle: number; readonly u: number; readonly v: number; readonly w: number; readonly distance: number }
+
+/** A mesh's triangles binned by the cells their boxes cross: the nearest point to a point, searched ring by ring. */
+export class TriangleGrid {
