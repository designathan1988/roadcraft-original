+/**
+ * DISTANCES BETWEEN A BODY'S SURFACES: the nearest point of a triangle mesh to a point (a grid of its triangles), points spread over a
+ * mesh by area, and the two-sided distance between two meshes measured on those points. What a level's error is (`lodLadder.ts`).
+ */
+
+/** The closest point of triangle abc to p: its barycentrics (u, v, w) and squared distance (Ericson, Real-Time Collision Detection, 5.1.5),
+ *  written into `out`. Scalars only: it runs millions of times a body. */
+export function closestOnTriangle(px: number, py: number, pz: number, ax: number, ay: number, az: number, bx: number, by: number, bz: number,
+  cx: number, cy: number, cz: number, out: Float64Array): void {
+  const abx = bx - ax, aby = by - ay, abz = bz - az, acx = cx - ax, acy = cy - ay, acz = cz - az;
+  const apx = px - ax, apy = py - ay, apz = pz - az;
+  let u: number, v: number, w: number;
+  const d1 = abx * apx + aby * apy + abz * apz, d2 = acx * apx + acy * apy + acz * apz;
+  const bpx = px - bx, bpy = py - by, bpz = pz - bz;
+  const d3 = abx * bpx + aby * bpy + abz * bpz, d4 = acx * bpx + acy * bpy + acz * bpz;
+  const cpx = px - cx, cpy = py - cy, cpz = pz - cz;
+  const d5 = abx * cpx + aby * cpy + abz * cpz, d6 = acx * cpx + acy * cpy + acz * cpz;
+  const vc = d1 * d4 - d3 * d2, vb = d5 * d2 - d1 * d6, va = d3 * d6 - d5 * d4;
+  if (d1 <= 0 && d2 <= 0) { u = 1; v = 0; w = 0; }
+  else if (d3 >= 0 && d4 <= d3) { u = 0; v = 1; w = 0; }
+  else if (vc <= 0 && d1 >= 0 && d3 <= 0) { v = d1 / (d1 - d3); u = 1 - v; w = 0; }
