{
 "storage": {
  "roadcraft.quality": "ultra"
 },
 "viewport": [
  1920,
  1080
 ],
 "steps": [
  {
   "eval": "performance.clearMarks(); window.__roadcraft.setTraffic(false); window.__roadcraft.generateCity({ seed: 7, size: 'small' }); 'started'"
  },
  {
   "until": "performance.getEntriesByName('city:applied').length > 0 && performance.getEntriesByName('opening:shown').length > 0",
   "name": "city shown",
   "timeout": 300000,
   "polling": 250
  },
  {
   "until": "(() => { const c = document.getElementById('loading-curtain'); return !!c && getComputedStyle(c).display === 'none'; })()",
   "name": "curtain gone",
   "timeout": 120000,
   "polling": 250
  },
  {
   "press": "Come\u00e7ar a construir",
   "optional": true
  },
  {
   "press": "Continuar",
   "optional": true
  },
  {
   "wait": 2000
  },
  {
   "eval": "window.__roadcraft.sim.setClock(720); window.__roadcraft.scene().setSkyMode('day'); window.__roadcraft.measure(true); 1"
  },
  {
   "setView": [
    0,
    0,
    2.5,
    45,
    48
   ]
  },
  {
   "wait": 15000
  },
  {
   "shot": "distrito"
  },
  {
   "setView": [
    60,
    0,
    8,
    30,
    35
   ]
  },
  {
   "wait": 15000
  },
  {
   "shot": "quadra"
  },
  {
   "setView": [
    60,
    0,
    30,
    30,
    15
   ]
  },
  {
   "wait": 15000
  },
  {
   "shot": "fachada"
  },
  {
   "setView": [
    0,
    0,
    20,
    200,
    12
   ]
  },
  {
   "wait": 15000
  },
  {
   "shot": "perto-a"
  },
  {
   "setView": [
    -120,
    40,
    20,
    60,
    12
   ]
  },
  {
   "wait": 15000
  },
  {
   "shot": "perto-b"
  }
 ]
}